<?xml version="1.0" encoding="UTF-8"?>
<!--
  Deploy this file as web.config in the ROOT of the pim.regira.com IIS site
  (the physical folder one level above manager\). Without it the site root has
  no default document and IIS answers with a bare 403.

  Uses a URL Rewrite redirect (the module is already required by the /manager
  SPA) instead of httpRedirect, so it cannot cascade into child applications.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Root to manager" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect" url="/manager/" redirectType="Found" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
